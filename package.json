{
  "name": "@outloud/css",
  "type": "module",
  "version": "4.0.0",
  "description": "CSS preset for UnoCSS by Outloud.",
  "license": "MIT",
  "homepage": "https://docs.outloud.dev/css",
  "repository": {
    "type": "git",
    "url": "https://github.com/madebyoutloud/css.git"
  },
  "author": "Outloud <hello@outloud.co> (https://outloud.co)",
  "contributors": [
    "Andrej Adamcik <andrej@outloud.co>"
  ],
  "keywords": [
    "unocss",
    "outloud",
    "css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./helpers": {
      "types": "./dist/helpers.d.mts",
      "default": "./dist/helpers.mjs"
    },
    "./*": "./dist/*"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "migrations"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint && oxfmt --check",
    "fmt": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "docs:dev": "pnpm --filter ./docs run dev",
    "docs:generate": "pnpm --filter ./docs run generate",
    "release": "pnpm build && release-it"
  },
  "dependencies": {
    "@unocss/core": "^66.12.0",
    "@unocss/preset-mini": "^66.12.0",
    "@unocss/reset": "^66.12.0",
    "@unocss/rule-utils": "^66.12.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@outloud/oxfmt-config": "^2.0.2",
    "@outloud/oxlint-config": "^2.0.2",
    "@outloud/tsconfig": "^2.0.2",
    "@types/node": "^24.19.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "release-it": "^21.1.2",
    "sass-embedded": "^1.97.1",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "unocss": "^66.12.0",
    "vitest": "^5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12",
      "onFail": "warn"
    }
  }
}
